{
  "name": "@agegr/pi-web",
  "version": "0.12.2",
  "description": "Web UI for the pi coding agent",
  "homepage": "https://github.com/agegr/pi-web#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/agegr/pi-web.git"
  },
  "bugs": {
    "url": "https://github.com/agegr/pi-web/issues"
  },
  "license": "MIT",
  "engines": {
    "node": ">=22.19.0"
  },
  "browserslist": [
    "chrome 111",
    "edge 111",
    "firefox 111",
    "safari 16.2",
    "ios_saf 16.2"
  ],
  "bin": {
    "pi-web": "bin/pi-web.js"
  },
  "files": [
    "bin",
    ".next",
    "!.next/cache",
    "!.next/dev",
    "!.next/**/*.js.map",
    "public",
    "next.config.ts",
    "package.json"
  ],
  "scripts": {
    "postinstall": "node bin/prepare-terminal.js && node bin/prepare-canvas.mjs",
    "dev": "node scripts/dev-with-shelf-previews.mjs",
    "dev:lan": "node scripts/dev-with-shelf-previews.mjs --lan",
    "build": "next build --webpack",
    "start": "next start -H 127.0.0.1 -p 30141",
    "start:lan": "next start -H 0.0.0.0 -p 30141",
    "lint": "eslint .",
    "telegram": "node --env-file-if-exists=.env.local --experimental-strip-types scripts/telegram/bridge.ts",
    "robin:storage": "node --experimental-strip-types scripts/robin-task-storage.ts",
    "test:terminal": "node e2e/terminal.mjs",
    "test:e2e": "node e2e/run.mjs",
    "test": "node --import ./scripts/test-style-stub.mjs --experimental-strip-types --test \"app/**/*.test.mjs\" \"components/**/*.test.mjs\" \"extension/**/*.test.mjs\" \"hooks/**/*.test.mjs\" \"lib/**/*.test.mjs\" \"public/**/*.test.mjs\" \"scripts/**/*.test.mjs\"",
    "release": "npm version patch --no-git-tag-version && npm run build && npm publish --access public"
  },
  "dependencies": {
    "@earendil-works/pi-agent-core": "1.2.0",
    "@earendil-works/pi-ai": "1.2.0",
    "@earendil-works/pi-codemode": "1.2.0",
    "@earendil-works/pi-coding-agent": "1.2.0",
    "@earendil-works/pi-mcp": "1.2.0",
    "@earendil-works/pi-telemetry": "1.2.0",
    "@earendil-works/pi-tui": "1.2.0",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/xterm": "6.0.0",
    "@excalidraw/excalidraw": "^0.18.1",
    "d3-force": "3.0.0",
    "diff": "9.0.0",
    "fflate": "0.8.3",
    "js-yaml": "^5.2.3",
    "jsqr": "1.4.0",
    "next": "16.3.8",
    "node-pty": "1.2.0-beta.15",
    "pdf-lib": "1.17.1",
    "proper-lockfile": "4.1.2",
    "qrcode": "1.5.4",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "semver": "7.8.5",
    "undici": "8.11.0",
    "web-push": "^3.6.7"
  },
  "overrides": {
    "@excalidraw/excalidraw": {
      "nanoid": "^3.3.18",
      "sass": "^1.80.0",
      "@excalidraw/mermaid-to-excalidraw": {
        "nanoid": "^5.1.16"
      }
    }
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.2.2",
    "@types/d3-force": "3.0.10",
    "@types/js-yaml": "^4.0.9",
    "@types/mdast": "^4.0.4",
    "@types/node": "^25",
    "@types/proper-lockfile": "4.1.4",
    "@types/qrcode": "1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/react-syntax-highlighter": "^15.5.13",
    "@types/semver": "7.8.0",
    "@types/web-push": "^3.6.4",
    "ansi_up": "^6.0.6",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "jiti": "^2.7.0",
    "katex": "^0.16.47",
    "mammoth": "^1.12.0",
    "mermaid": "^11.16.1",
    "playwright": "^1.62.1",
    "postcss": "^8.5.26",
    "react-markdown": "^10.1.0",
    "react-syntax-highlighter": "^16.1.1",
    "rehype-katex": "^7.0.1",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "remark-cjk-friendly": "^2.3.2",
    "remark-frontmatter": "^5.0.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "tailwindcss": "^4.2.2",
    "typebox": "^1.3.7",
    "typescript": "^5"
  },
  "allowScripts": {
    "node-pty@1.2.0-beta.15": true
  },
  "trustedDependencies": [
    "node-pty"
  ]
}
